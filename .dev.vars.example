# Copy to .dev.vars for local development only. This example contains no credentials.
# Never prefix secrets with VITE_ or NEXT_PUBLIC_. Never commit the populated file.
AICD_AUTH_MODE="supabase"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
AICD_OWNER_EMAIL=""

# Optional owner-configured Kimi extraction. The key enables paid processing.
# For npm run local, edit .aicd-local/.dev.vars instead: this root file is ignored.
# The API endpoint is fixed to https://api.moonshot.ai/v1 by server code.
MOONSHOT_API_KEY=""
# Optional override. An omitted model uses kimi-k2.6.
MOONSHOT_MODEL="kimi-k2.6"
